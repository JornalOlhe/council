{
  "name": "ia-council-desktop",
  "productName": "IA Council",
  "version": "1.0.0",
  "description": "IA Council para Windows: o conselho de IAs e o Copiloto que mexe no seu PC.",
  "author": "JornalOlhe",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-control.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jornalolhe.iacouncil",
    "productName": "IA Council",
    "files": [
      "main.js",
      "preload.js",
      "control.js",
      "input.ps1",
      "icon.png",
      "web.js",
      "extsync.js"
    ],
    "asarUnpack": [
      "input.ps1"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "IA-Council-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IA Council",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/JornalOlhe/council/releases/download/desktop-latest"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
