# Configure estas variáveis na Vercel (Settings > Environment Variables).
# Use só os provedores que quiser; basta 1 chave para funcionar.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=

# Modelos (opcional). Se o modelo deixar de existir, o servidor escolhe outro disponível sozinho.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=google/gemma-4-31b-it:free
CEREBRAS_MODEL=llama3.1-8b
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Opcional: se definido, o app exige este código (header x-access-code)
ACCESS_CODE=
